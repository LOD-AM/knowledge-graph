# A feature containing finds must also be an A2 stratigraphic volume unit (#6).
:obj a crm:E22_Human-Made_Object ; rdfs:label "Object"@en ; crm:P2_has_type aat:300037058 ; crmarchaeo:AP21i_is_contained_in :feat .
:feat a crm:E25_Human-Made_Feature ; rdfs:label "Feature"@en .
