# A run whose code is a branch, not a commit of LOD-AM/analyses (LOD-AM/planning#49).
:r a prov:Activity ; rdfs:label "Run"@en ;
    prov:used :r_input ;
    prov:generated <https://github.com/LOD-AM/analyses/blob/0123456789abcdef0123456789abcdef01234567/results/r.csv> ;
    prov:wasAssociatedWith :p ;
    prov:qualifiedAssociation :r_association ;
    prov:endedAtTime "2026-11-27T15:30:00Z"^^xsd:dateTime .
:r_association a prov:Association ; prov:agent :p ;
    prov:hadPlan <https://github.com/LOD-AM/analyses/blob/main/R/r.R> .
:r_input a prov:Collection ;
    prov:hadMember :a ;
    prov:wasDerivedFrom <https://doi.org/10.5281/zenodo.24469235> ;
    dcterms:source <https://github.com/LOD-AM/analyses/blob/0123456789abcdef0123456789abcdef01234567/queries/r.rq> .
<https://doi.org/10.5281/zenodo.24469235> a prov:Entity ;
    dcterms:identifier "7e6fde30b95209428b92094ecaa961c0c75f1c2ab689a99dbea0e168167956d2" .
:a a crm:E27_Site ; rdfs:label "Site"@en .
:p a foaf:Person ; foaf:name "P" .
