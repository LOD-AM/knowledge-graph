# LOD-AM modelling conventions as SHACL shapes.
# These encode CONVENTIONS.md. Change both together.
# Validate with: make validate   (tools/validate.py)

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci:  <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/> .
@prefix afm:     <http://purl.allotrope.org/ontologies/material#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix afr:     <http://purl.allotrope.org/ontologies/result#> .
@prefix afx:     <http://purl.allotrope.org/ontologies/property#> .
@prefix qudt:    <http://qudt.org/schema/qudt#> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix lodsh:   <https://lod-am.net/shapes/> .
@prefix :        <https://lod-am.net/id/> .

# --- Every local resource is typed -----------------------------------------
lodsh:LocalResourceShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
              { ?this ?p ?o } UNION { ?s ?p ?this }
              FILTER(isIRI(?this) && STRSTARTS(STR(?this), "https://lod-am.net/id/"))
            }""" ] ;
    sh:property [ sh:path rdf:type ; sh:minCount 1 ;
        sh:message "Every https://lod-am.net/id/ resource needs at least one rdf:type." ] .

# --- Labels on main resources (#12) -------------------------------------------
# Objects, features, sites, samples, analyses, groups and analysis runs carry a language-tagged
# rdfs:label. Helper nodes (identifiers, type assignments, time-spans, sampling
# events, measurements) need none; the website names them from their context.
# Types and materials use skos:prefLabel (TypeShape); persons foaf:name; works dcterms:title.
lodsh:LabelShape a sh:NodeShape ;
    sh:targetClass crm:E22_Human-Made_Object, crm:E25_Human-Made_Feature, crm:E27_Site,
                   crmsci:S13_Sample, crm:E7_Activity, crm:E74_Group, prov:Activity ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype rdf:langString ;
        sh:message "Main resources need a language-tagged rdfs:label." ] ;
    sh:property [ sh:path rdfs:label ; sh:severity sh:Warning ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ; sh:qualifiedMinCount 1 ;
        sh:message "Main resources should have an English label (@en)." ] .

lodsh:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:property [ sh:path foaf:name ; sh:minCount 1 ] .

# --- Objects ----------------------------------------------------------------
lodsh:ObjectShape a sh:NodeShape ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:property [ sh:path crm:P2_has_type ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "Objects need a type shortcut (crm:P2_has_type), even if a full E17 assignment exists." ] ;
    sh:property [ sh:path crm:P45_consists_of ; sh:nodeKind sh:IRI ; sh:severity sh:Warning ;
        sh:minCount 1 ; sh:message "Objects should state their material (crm:P45_consists_of)." ] ;
    sh:property [ sh:path crm:P70i_is_documented_in ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "Objects should cite the publication they come from (crm:P70i_is_documented_in)." ] ;
    sh:property [ sh:path rdf:type ; sh:not [ sh:hasValue afm:AFM_0001099 ] ;
        sh:message "Only samples carry the AFO material class afm:AFM_0001099 (chemical mixture), not objects (#3)." ] ;
    sh:property [ sh:path crm:P53_has_former_or_current_location ; sh:class crm:E53_Place ;
        sh:message "An object without a feature points to its site's place (crm:E53_Place), #19." ] .

# Find context (#19): a find is in a feature, or (no feature known) at its site's place.
# Parts of an object (targets of crm:P46_is_composed_of) inherit the context of the whole.
lodsh:FindContextShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
        SELECT DISTINCT ?this WHERE {
          ?this a crm:E22_Human-Made_Object .
          FILTER NOT EXISTS { ?whole crm:P46_is_composed_of ?this }
        }""" ] ;
    sh:or ( [ sh:path crmarchaeo:AP21i_is_contained_in ; sh:minCount 1 ]
            [ sh:path crm:P53_has_former_or_current_location ; sh:minCount 1 ] ) ;
    sh:severity sh:Warning ;
    sh:message "Objects should have a find context: the feature (crmarchaeo:AP21i_is_contained_in) or, without a feature, the site's place (crm:P53_has_former_or_current_location), #19." .

# Converted finds (LOD-AM/ingest#10, knowledge-graph#28): an object typed with a LOD-AM typology
# concept reaches AAT only through the concept's match, not with its own crm:P2_has_type
lodsh:TypologyOnlyLocalShape a sh:NodeShape ;
    sh:targetClass crm:E22_Human-Made_Object ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "An object typed with a LOD-AM typology concept has no AAT type of its own; AAT is reached through the concept's skos:closeMatch / skos:broadMatch." ;
        sh:select """
            PREFIX crm:  <http://www.cidoc-crm.org/cidoc-crm/>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
              $this crm:P2_has_type ?t , ?value .
              ?t skos:inScheme <https://lod-am.net/id/typology> .
              FILTER(STRSTARTS(STR(?value), "http://vocab.getty.edu/aat/")) }""" ] .

lodsh:TypologyConceptShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT ?this WHERE { ?this skos:inScheme <https://lod-am.net/id/typology> }""" ] ;
    sh:or ( [ sh:path skos:broader ; sh:minCount 1 ] [ sh:path skos:topConceptOf ; sh:minCount 1 ] ) ;
    sh:message "A typology concept has a broader concept, or is a top concept (class) of the typology." .

lodsh:TypeAssignmentShape a sh:NodeShape ;
    sh:targetClass crm:E17_Type_Assignment ;
    sh:property [ sh:path crm:P41_classified ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path crm:P42_assigned ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lodsh:TypeShape a sh:NodeShape ;
    sh:targetClass crm:E55_Type, crm:E57_Material ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ;
        sh:message "Types and materials need a skos:prefLabel." ] .

lodsh:LocalTypeMatchShape a sh:NodeShape ;
    # Local types (typology, site/feature types) match AAT; topics match Wikidata (TopicShape)
    sh:target [ a sh:SPARQLTarget ; sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT ?this WHERE { ?this skos:closeMatch|skos:broadMatch ?m .
          FILTER NOT EXISTS { ?this skos:inScheme <https://lod-am.net/id/topics> } }""" ] ;
    sh:property [ sh:path [ sh:alternativePath ( skos:closeMatch skos:broadMatch ) ] ; sh:nodeKind sh:IRI ;
        sh:pattern "^http://vocab[.]getty[.]edu/aat/[0-9]+$" ;
        sh:message "Local types match AAT concepts: skos:closeMatch / skos:broadMatch → http://vocab.getty.edu/aat/<id> (#7)." ] .

lodsh:IdentifierShape a sh:NodeShape ;
    sh:targetClass crm:E42_Identifier ;
    sh:property [ sh:path crm:P190_has_symbolic_content ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# --- Sites and places --------------------------------------------------------
lodsh:SiteShape a sh:NodeShape ;
    sh:targetClass crm:E27_Site ;
    sh:property [ sh:path owl:sameAs ; sh:maxCount 0 ;
        sh:message "Link a site to Pleiades with an E42_Identifier (crm:P1_is_identified_by), not owl:sameAs (#4)." ] .

lodsh:AppellationShape a sh:NodeShape ;
    sh:targetClass crm:E41_Appellation ;
    sh:property [ sh:path crm:P190_has_symbolic_content ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A name (E41_Appellation) has exactly one crm:P190_has_symbolic_content string." ] .

lodsh:SiteNameAsReportedShape a sh:NodeShape ;
    sh:targetClass crm:E27_Site ;
    sh:property [ sh:path crm:P1_is_identified_by ;
        sh:qualifiedValueShape [ sh:path crm:P2_has_type ; sh:hasValue :name_as_reported ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A site has at most one name as reported." ] .

lodsh:PlaceCertaintyShape a sh:NodeShape ;
    sh:targetClass crm:E53_Place ;
    sh:property [ sh:path crm:P2_has_type ; sh:maxCount 1 ;
        sh:in ( :location_uncertain :location_vicinity :location_area ) ;
        sh:message "A place's crm:P2_has_type is at most one location certainty (:location_uncertain, :location_vicinity, :location_area)." ] .

lodsh:GeometryShape a sh:NodeShape ;
    sh:targetClass geo:Geometry ;
    sh:property [ sh:path geo:asWKT ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype geo:wktLiteral ;
        sh:message "Geometries carry exactly one geo:asWKT literal typed geo:wktLiteral (#8)." ] .

lodsh:PlaceGeometryShape a sh:NodeShape ;
    sh:targetSubjectsOf geo:hasGeometry ;
    sh:property [ sh:path geo:hasGeometry ; sh:class geo:Geometry ] .

# --- Time ------------------------------------------------------------------
lodsh:TimeSpanShape a sh:NodeShape ;
    sh:targetClass crm:E52_Time-Span ;
    sh:or ( [ sh:path crm:P79_beginning_is_qualified_by ; sh:minCount 1 ]
            [ sh:path crm:P80_end_is_qualified_by ; sh:minCount 1 ]
            [ sh:path crm:P82_at_some_time_within ; sh:minCount 1 ] ) .

# --- Analytics -------------------------------------------------------------
lodsh:AnalysisShape a sh:NodeShape ;
    sh:targetClass crm:E7_Activity ;
    sh:property [ sh:path afx:AFX_0000399 ; sh:minCount 1 ;
        sh:message "An analysis needs its input sample (afx:AFX_0000399 has input)." ] ;
    sh:property [ sh:path afx:AFX_0000395 ; sh:minCount 1 ;
        sh:message "An analysis needs its measurements (afx:AFX_0000395 has output)." ] ;
    sh:property [ sh:path crm:P14_carried_out_by ; sh:minCount 1 ; sh:severity sh:Warning ] .

lodsh:IsotopeRatioShape a sh:NodeShape ;
    sh:targetClass afr:AFR_0002368 ;   # analyte molar ratio (lead isotope ratios, #14)
    sh:property [ sh:path afx:AFX_0002816 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A ratio quantifies exactly one nuclide, the numerator (afx:AFX_0002816)." ] ;
    sh:property [ sh:path afx:AFX_0001550 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A ratio has exactly one reference nuclide, the denominator (afx:AFX_0001550 has reference)." ] ;
    sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "A ratio has exactly one value, as reported (qudt:numericValue, xsd:decimal)." ] ;
    sh:property [ sh:path qudt:unit ; sh:maxCount 0 ;
        sh:message "Ratios are dimensionless: no qudt:unit." ] .

# Phases and cultures (LOD-AM/ingest#17): contexts witness a phase, which is part of one culture
lodsh:WitnessedPhaseShape a sh:NodeShape ;
    sh:targetObjectsOf crm:P8i_witnessed ;
    sh:property [ sh:path crm:P9_consists_of ; sh:maxCount 0 ;
        sh:message "Contexts witness the phase, not the culture: a period that consists of other periods is not a target of crm:P8i_witnessed." ] .

lodsh:PhaseShape a sh:NodeShape ;
    sh:targetSubjectsOf crm:P9i_forms_part_of ;
    sh:property [ sh:path crm:P9i_forms_part_of ; sh:maxCount 1 ;
        sh:message "A phase is part of exactly one culture (crm:P9i_forms_part_of)." ] .

# A chronology system names its source publication (owner, 2026-11-19; as PeriodO collections)
lodsh:ChronologySystemShape a sh:NodeShape ;
    # the scheme of a phase (a local crm:E4_Period), and every converted /id/chronology/<uuid>
    sh:target [ a sh:SPARQLTarget ; sh:select """
        PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT ?this WHERE {
          { ?phase a crm:E4_Period ; skos:inScheme ?this .
            FILTER(STRSTARTS(STR(?phase), "https://lod-am.net/id/")) }
          UNION { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/chronology/[0-9a-f-]{36}$")) } }""" ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class crm:E31_Document ;
        sh:message "A chronology system (the scheme of the phases) names its source publication with exactly one dcterms:source (a crm:E31_Document)." ] .

lodsh:CultureShape a sh:NodeShape ;
    sh:targetSubjectsOf crm:P9_consists_of ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Culture and phase state the link both ways (crm:P9_consists_of and crm:P9i_forms_part_of)." ;
        sh:select """
            PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
            SELECT $this ?value WHERE { $this crm:P9_consists_of ?value .
              FILTER NOT EXISTS { ?value crm:P9i_forms_part_of $this } }""" ] .

lodsh:ContainedInShape a sh:NodeShape ;
    sh:targetObjectsOf crmarchaeo:AP21i_is_contained_in ;
    sh:class crmarchaeo:A2_Stratigraphic_Volume_Unit ;
    sh:message "A feature that contains finds is also a crmarchaeo:A2_Stratigraphic_Volume_Unit (#6)." .

lodsh:SampleTakingShape a sh:NodeShape ;
    sh:targetClass crmsci:S2_Sample_Taking ;
    sh:property [ sh:path crmsci:O3_sampled_from ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A sampling names the object or part it was taken from (crmsci:O3_sampled_from)." ] ;
    sh:property [ sh:path crmsci:O5_removed ; sh:minCount 1 ; sh:class crmsci:S13_Sample ;
        sh:message "A sampling names its sample (crmsci:O5_removed), typed crmsci:S13_Sample." ] .

lodsh:SampleShape a sh:NodeShape ;
    sh:targetClass crmsci:S13_Sample ;
    sh:property [ sh:path [ sh:inversePath crmsci:O5_removed ] ; sh:minCount 1 ;
        sh:message "Every sample comes from a sampling event (crmsci:S2_Sample_Taking ... crmsci:O5_removed), #2." ] .

lodsh:MeasurementShape a sh:NodeShape ;
    sh:targetClass afr:AFR_0002036 , afr:AFR_0002099 ;   # concentration (real concentrations only), mass fraction (wt %)
    sh:property [ sh:path afx:AFX_0002816 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A measurement quantifies exactly one element/compound (afx:AFX_0002816)." ] ;
    sh:property [ sh:path qudt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "Units are QUDT unit IRIs (e.g. unit:PERCENT), not strings." ] ;
    sh:property [ sh:path qudt:numericValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:xone ( [ sh:path qudt:numericValue ; sh:minCount 1 ]
              [ sh:path afx:AFX_0000331 ; sh:minCount 1 ]
              [ sh:path crm:P2_has_type ; sh:hasValue :not_detected ] ) ;
    sh:message "A measurement has exactly one of: a value (qudt:numericValue), only an upper limit (afx:AFX_0000331 maximum), or the type :not_detected (#21)." .

lodsh:NotDetectedShape a sh:NodeShape ;
    sh:targetSubjectsOf crm:P2_has_type ;
    sh:or ( [ sh:not [ sh:path crm:P2_has_type ; sh:hasValue :not_detected ] ]
            [ sh:class crm:E54_Dimension ] ) ;
    sh:message "A :not_detected measurement is also a crm:E54_Dimension, so crm:P2_has_type is within its domain (#21)." .

# --- Literature ------------------------------------------------------------
lodsh:PublicationShape a sh:NodeShape ;
    sh:targetClass fabio:JournalArticle, fabio:Book, fabio:BookChapter, fabio:Thesis, fabio:ConferencePaper ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:message "Publications need a dcterms:title." ] ;
    sh:property [ sh:path fabio:hasPublicationYear ; sh:maxCount 1 ; sh:datatype xsd:gYear ] ;
    sh:property [ sh:path dcterms:creator ; sh:class foaf:Person ] ;
    sh:property [ sh:path dcterms:contributor ; sh:class foaf:Person ] .

lodsh:ChapterShape a sh:NodeShape ;
    sh:targetClass fabio:BookChapter ;
    sh:property [ sh:path dcterms:isPartOf ; sh:class fabio:Book ; sh:maxCount 1 ;
        sh:message "A book chapter is part of one fabio:Book (dcterms:isPartOf)." ] .

lodsh:ArticleShape a sh:NodeShape ;
    sh:targetClass fabio:JournalArticle ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ] ;
    sh:property [ sh:path dcterms:creator ; sh:minCount 1 ; sh:class foaf:Person ] ;
    sh:property [ sh:path fabio:hasPublicationYear ; sh:maxCount 1 ; sh:datatype xsd:gYear ] .

# --- Statistical analyses (PROV-O, LOD-AM/planning#48, #49, #50) -----------------
# A run of an R analysis in LOD-AM/analyses: one input collection (the analysed records,
# from one data release), at least one result, the person with the code at a commit (and the
# MaRDI methods), the MaRDI software, the end time.
lodsh:RunShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [ sh:path prov:used ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Collection ;
        sh:message "A run uses exactly one input collection (prov:used → prov:Collection of the analysed records)." ] ;
    sh:property [ sh:path prov:generated ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A run names its results (prov:generated → the result files)." ] ;
    sh:property [ sh:path prov:wasAssociatedWith ;
        sh:or ( [ sh:class foaf:Person ] [ sh:class prov:SoftwareAgent ] ) ;
        sh:qualifiedValueShape [ sh:class foaf:Person ] ; sh:qualifiedMinCount 1 ;
        sh:message "A run names who ran it and the software (prov:wasAssociatedWith → foaf:Person, prov:SoftwareAgent; shortcuts of the associations)." ] ;
    sh:property [ sh:path prov:qualifiedAssociation ; sh:minCount 1 ; sh:node lodsh:AssociationShape ;
        sh:qualifiedValueShape lodsh:PersonAssociationShape ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
        sh:message "A run has exactly one association with the person and the code, and one per MaRDI software item." ] ;
    sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A run has one prov:endedAtTime (xsd:dateTime)." ] .

lodsh:AssociationShape a sh:NodeShape ;
    sh:xone ( lodsh:PersonAssociationShape lodsh:SoftwareAssociationShape ) ;
    sh:message "An association of a run is either the person with the code (and MaRDI methods) or a MaRDI software item." .

# The person who ran it, the code at a commit of LOD-AM/analyses, and MaRDI methods (algorithm, model, task).
lodsh:PersonAssociationShape a sh:NodeShape ;
    sh:property [ sh:path prov:agent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Person ] ;
    sh:property [ sh:path prov:hadPlan ; sh:class prov:Plan ; sh:nodeKind sh:IRI ;
        sh:pattern "^(https://github[.]com/LOD-AM/analyses/blob/[0-9a-f]{40}/|https://portal[.]mardi4nfdi[.]de/entity/Q[0-9]+$)" ;
        sh:qualifiedValueShape [ sh:pattern "^https://github[.]com/LOD-AM/analyses/blob/[0-9a-f]{40}/" ] ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
        sh:message "Plans of a run (prov:Plan): exactly one code file of LOD-AM/analyses at a commit (https://github.com/LOD-AM/analyses/blob/<commit>/…), plus MaRDI methods (mardi:Q…)." ] .

# Software (R, R packages) as a MaRDI software item.
lodsh:SoftwareAssociationShape a sh:NodeShape ;
    sh:property [ sh:path prov:agent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:SoftwareAgent ;
        sh:pattern "^https://portal[.]mardi4nfdi[.]de/entity/Q[0-9]+$" ;
        sh:message "Software of a run is a MaRDI software item (mardi:Q…, a prov:SoftwareAgent)." ] ;
    sh:property [ sh:path prov:hadPlan ; sh:maxCount 0 ] .

lodsh:RunInputShape a sh:NodeShape ;
    sh:targetClass prov:Collection ;
    sh:property [ sh:path prov:hadMember ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:pattern "^https://lod-am[.]net/id/" ;
        sh:message "The input collection lists every analysed LOD-AM record (prov:hadMember)." ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:pattern "^https://doi[.]org/10[.]5281/zenodo[.][0-9]+$" ; sh:node lodsh:ReleaseShape ;
        sh:message "The input comes from one data release: the version DOI of its website release (https://doi.org/10.5281/zenodo.<n>), #48." ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "The input collection names the query that selected it (dcterms:source → the .rq file in LOD-AM/analyses)." ] .

lodsh:ReleaseShape a sh:NodeShape ;
    sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "A release carries the sha256 of its manifest (data/release-manifest.json of the website release) as dcterms:identifier." ] .

lodsh:RunIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT DISTINCT ?this WHERE { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/run/[0-9a-f-]{36}$")) }""" ] ;
    sh:class prov:Activity ; sh:message "IRIs /id/run/<uuid> are prov:Activity (analysis runs)." .

# --- IRIs of converted data (#20) ----------------------------------------------
# Converted records: https://lod-am.net/id/<kind>/<id_uuid>, helper nodes .../<id_uuid>/<role>.
# The kind in the path must match the class.
lodsh:ConvertedIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
              { ?this ?p ?o } UNION { ?s ?p ?this }
              FILTER(isIRI(?this) && REGEX(STR(?this), "^https://lod-am[.]net/id/(site|feature|find|analysis|period|culture|chronology|type|region|lab|person|journal|run)/"))
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Converted IRIs are https://lod-am.net/id/<kind>/<uuid> or .../<uuid>/<role> (lower-case uuid, role in snake_case), #20." ;
        sh:select """
            SELECT $this WHERE {
              FILTER(!REGEX(STR($this), "^https://lod-am[.]net/id/[a-z]+/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/[a-z0-9_]+)?$"))
            }""" ] .

lodsh:SiteIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT DISTINCT ?this WHERE { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/site/[0-9a-f-]{36}$")) }""" ] ;
    sh:class crm:E27_Site ; sh:message "IRIs /id/site/<uuid> are crm:E27_Site (#20)." .

lodsh:FeatureIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT DISTINCT ?this WHERE { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/feature/[0-9a-f-]{36}$")) }""" ] ;
    sh:class crm:E25_Human-Made_Feature ; sh:message "IRIs /id/feature/<uuid> are crm:E25_Human-Made_Feature (#20)." .

lodsh:FindIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT DISTINCT ?this WHERE { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/find/[0-9a-f-]{36}$")) }""" ] ;
    sh:class crm:E22_Human-Made_Object ; sh:message "IRIs /id/find/<uuid> are crm:E22_Human-Made_Object (#20)." .

lodsh:AnalysisIriShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        SELECT DISTINCT ?this WHERE { ?this ?p ?o FILTER(REGEX(STR(?this), "^https://lod-am[.]net/id/analysis/[0-9a-f-]{36}$")) }""" ] ;
    sh:class crm:E7_Activity ; sh:message "IRIs /id/analysis/<uuid> are crm:E7_Activity (#20)." .

lodsh:TopicShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT ?this WHERE { ?this skos:inScheme <https://lod-am.net/id/topics> }""" ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ;
        sh:message "A topic needs a skos:prefLabel." ] ;
    sh:property [ sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:nodeKind sh:IRI ; sh:pattern "^http://www[.]wikidata[.]org/entity/Q[0-9]+$" ;
        sh:message "Topics match Wikidata items (skos:exactMatch / closeMatch / broadMatch → wd:Q…, listed in tools/wikidata.tsv)." ] .
