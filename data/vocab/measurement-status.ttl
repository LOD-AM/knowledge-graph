# LOD-AM local concepts for the status of a measurement (knowledge-graph#21).
# Hand-written, not generated by a converter. See CONVENTIONS.md, "Analytics".
@prefix :     <https://lod-am.net/id/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:measurement_status a skos:ConceptScheme ;
    skos:prefLabel "LOD-AM measurement status"@en, "LOD-AM Messstatus"@de .

:not_detected a crm:E55_Type, skos:Concept ;
    skos:inScheme :measurement_status ;
    skos:prefLabel "not detected"@en, "nicht nachgewiesen"@de ;
    skos:definition "The analysis looked for the element but did not detect it; no detection limit is known. Not the same as not analysed (then there is no measurement at all)."@en .
