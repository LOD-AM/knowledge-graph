    skos:scopeNote "Place vocabularies such as Pleiades or GeoNames."@en ;
    skos:broader :topic_controlled_vocabularies ;
    skos:exactMatch wd:Q1006160 .

# --- Research data -----------------------------------------------------------------------------

:topic_research_data_management a skos:Concept ;
    skos:inScheme :topics ; skos:topConceptOf :topics ;
    skos:prefLabel "research data management"@en, "Forschungsdatenmanagement"@de ;
    skos:exactMatch wd:Q30089794 .

:topic_open_data a skos:Concept ;
    skos:inScheme :topics ;
    skos:prefLabel "open data"@en, "Open Data"@de ;
    skos:broader :topic_research_data_management ;
    skos:exactMatch wd:Q309901 .

:topic_fair_data a skos:Concept ;
    skos:inScheme :topics ;
    skos:prefLabel "FAIR data"@en, "FAIRe Daten"@de ;
    skos:scopeNote "No Wikidata match yet: the item for the FAIR principles (Q29032648) has no English label, which the Wikidata check requires."@en ;
    skos:broader :topic_research_data_management .

:topic_data_modelling a skos:Concept ;
    skos:inScheme :topics ;
    skos:prefLabel "data modelling"@en, "Datenmodellierung"@de ;
    skos:broader :topic_research_data_management ;
    skos:exactMatch wd:Q367664 .

:topic_legacy_data a skos:Concept ;
    skos:inScheme :topics ;
    skos:prefLabel "legacy data"@en, "Altdaten"@de ;                                # de: draft
    skos:scopeNote "Data from older publications and databases, with their gaps and inconsistencies. No Wikidata match: 'legacy system' (Q445962) means old software."@en ;
    skos:broader :topic_research_data_management ;
    skos:related :topic_data_cleaning .

:topic_data_cleaning a skos:Concept ;
    skos:inScheme :topics ;
    skos:prefLabel "data cleaning"@en, "Datenbereinigung"@de ;
    skos:broader :topic_research_data_management ;
    skos:exactMatch wd:Q1172378 .

# --- Digital humanities and infrastructure ------------------------------------------------------

:topic_digital_humanities a skos:Concept ;
    skos:inScheme :topics ; skos:topConceptOf :topics ;
    skos:prefLabel "digital humanities"@en, "Digital Humanities"@de ;
    skos:exactMatch wd:Q1026962 .

:topic_self_hosting a skos:Concept ;
    skos:inScheme :topics ; skos:topConceptOf :topics ;
    skos:prefLabel "self-hosting"@en, "Self-Hosting"@de ;                                  # de: draft
    skos:altLabel "homelab"@en, "infrastructure"@en ;
    skos:scopeNote "Running LOD-AM's services on one's own hardware (homelab, Docker, web server)."@en ;
    skos:exactMatch wd:Q65090673 .
