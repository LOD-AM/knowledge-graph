@prefix :          <https://lod-am.net/id/> .
@prefix crm:       <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/> .
@prefix crmsci:    <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix afm:       <http://purl.allotrope.org/ontologies/material#> .
@prefix afp:       <http://purl.allotrope.org/ontologies/process#> .
@prefix afr:       <http://purl.allotrope.org/ontologies/result#> .
@prefix afx:       <http://purl.allotrope.org/ontologies/property#> .
@prefix qudt:      <http://qudt.org/schema/qudt#> .
@prefix unit:      <http://qudt.org/vocab/unit#> .
@prefix fabio:     <http://purl.org/spar/fabio/> .
@prefix prism:     <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix foaf:      <http://xmlns.com/foaf/0.1/> .
@prefix aat:       <http://vocab.getty.edu/aat/> .
@prefix wd:        <http://www.wikidata.org/entity/> .
@prefix chebi:     <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix ror:       <https://ror.org/> .
@prefix geo:       <http://www.opengis.net/ont/geosparql#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# LOD-AM Combined Ontology Example
# ============================================================================
# This file demonstrates how LOD-AM uses CIDOC CRM, FABIO, and AFO together
# to represent archaeological objects, scientific analysis, and literature.
# ============================================================================

# ----------------------------------------------------------------------------
# SITES, FEATURES AND PLACES
# ----------------------------------------------------------------------------

:Arslantepe a crm:E27_Site ;
    rdfs:label "Arslantepe"@en ;
    crm:P2_has_type <https://pleiades.stoa.org/vocabularies/settlement> ;
    crm:P1_is_identified_by :Arslantepe_pleiades_id ;     # the Pleiades place, as an identifier (no owl:sameAs)
    crm:P1_is_identified_by :Arslantepe_name_as_reported ;   # the name as the literature gives it
    crm:P53_has_former_or_current_location :Arslantepe_location .

:Arslantepe_name_as_reported a crm:E41_Appellation ;
    crm:P2_has_type :name_as_reported ;                    # data/vocab/site-names-and-locations.ttl
    crm:P190_has_symbolic_content "Arslantepe" .

# A site of which only the area is known (LOD-AM/ingest: site_location_certainty "area").
# The point is a representative point of the area; the place says so with a local type.
:Akarnania a crm:E27_Site ;
    rdfs:label "Akarnania"@en ;
    crm:P1_is_identified_by :Akarnania_name_as_reported ;
    crm:P53_has_former_or_current_location :Akarnania_location .

:Akarnania_name_as_reported a crm:E41_Appellation ;
    crm:P2_has_type :name_as_reported ;
    crm:P190_has_symbolic_content "Akarnanien" .

:Akarnania_location a crm:E53_Place, geo:Feature ;
    crm:P2_has_type :location_area ;                       # only the area is known
    geo:hasGeometry :Akarnania_geometry .

:Akarnania_geometry a geo:Geometry ;
    geo:asWKT "POINT (21 38)"^^geo:wktLiteral .

:Arslantepe_pleiades_id a crm:E42_Identifier ;
    crm:P2_has_type :pleiades_place_uri ;
    crm:P190_has_symbolic_content "https://pleiades.stoa.org/places/25078867" .

:pleiades_place_uri a crm:E55_Type ;
    skos:prefLabel "Pleiades place URI"@en .

<https://pleiades.stoa.org/vocabularies/settlement> a crm:E55_Type ;
    skos:prefLabel "settlement"@en .

# Outline of the site, taken from the Pleiades location "OSM location of Arslantepe"
:Arslantepe_location a crm:E53_Place, geo:Feature ;
    geo:hasGeometry :Arslantepe_location_geometry .

:Arslantepe_location_geometry a geo:Geometry ;
    geo:asWKT "POLYGON ((38.3606437999999983 38.3811190999999994, 38.3607782999999998 38.3811273999999969, 38.3609021999999982 38.3811413000000030, 38.3610826999999972 38.3811717999999971, 38.3612407000000033 38.3812148000000022, 38.3614542999999983 38.3812939000000028, 38.3615853000000016 38.3813521000000009, 38.3618895999999978 38.3815906999999967, 38.3620488999999978 38.3817377000000022, 38.3622011000000001 38.3819098000000025, 38.3622931000000023 38.3820374000000015, 38.3623710000000031 38.3821705000000009, 38.3624099000000029 38.3823176000000004, 38.3623922000000022 38.3825007000000014, 38.3623638999999983 38.3826144000000014, 38.3622931000000023 38.3827392999999972, 38.3620044999999976 38.3830029000000010, 38.3618578000000028 38.3830499999999972, 38.3617056000000005 38.3830972000000017, 38.3615746999999985 38.3831193999999982, 38.3614304999999973 38.3831205999999980, 38.3612737999999993 38.3830888000000030, 38.3610578999999987 38.3830195000000032, 38.3609057000000035 38.3829446000000019, 38.3607713000000032 38.3828640999999990, 38.3606545000000025 38.3827920000000020, 38.3605164000000016 38.3826727000000005, 38.3603854999999996 38.3825533999999990, 38.3602793000000020 38.3824258000000000, 38.3601695999999990 38.3822481999999994, 38.3601023000000012 38.3821094999999985, 38.3600634000000014 38.3819625000000002, 38.3600457000000006 38.3818515000000033, 38.3600350999999975 38.3817238999999972, 38.3601625000000013 38.3814047999999985, 38.3602368000000027 38.3813133000000022, 38.3602934999999974 38.3812521999999987, 38.3603996000000009 38.3811883999999992, 38.3605057999999985 38.3811496000000005, 38.3606437999999983 38.3811190999999994))"^^geo:wktLiteral .

wd:Q43 a crm:E53_Place ;
    rdfs:label "Turkey"@en .


:Palace_Hoard a crm:E25_Human-Made_Feature, crmarchaeo:A2_Stratigraphic_Volume_Unit ;   # A2: finds are contained in it (#6)
    rdfs:label "Palace Hoard"@en, "Palasthort"@de ;
    crm:P2_has_type :hoard ;                                     # local feature type (#7)
    crm:P41i_was_classified_by :assignTypePalace_Hoard ;
    crm:P46i_forms_part_of :Arslantepe ;
    crm:P8i_witnessed <http://n2t.net/ark:/99152/p03wskdnzgc> .   # dating shortcut (#5)

:assignTypePalace_Hoard a crm:E17_Type_Assignment ;
    crm:P41_classified :Palace_Hoard ;
    crm:P42_assigned :hoard .

# Local site/feature type (#7): a SKOS concept with the AAT match where AAT has one
:hoard a crm:E55_Type, skos:Concept ;
    skos:prefLabel "hoard"@en, "Hort"@de ;
    skos:closeMatch aat:300195474 ;                              # hoards (groupings)
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

# ----------------------------------------------------------------------------
# PERIODS and TIME SPANs
# ----------------------------------------------------------------------------

<http://n2t.net/ark:/99152/p03wskdnzgc> a crm:E4_Period;
    skos:inScheme <http://n2t.net/ark:/99152/p03wskd> ;
    crm:P4_has_time-span :p03wskdnzgc_TIME_SPAN ;
    crm:P7_took_place_at wd:Q43 .

:p03wskdnzgc_TIME_SPAN a crm:E52_Time-Span;
    crm:P79_beginning_is_qualified_by "-2000";
    crm:P80_end_is_qualified_by "-1750" .

# ----------------------------------------------------------------------------
# ARCHAEOLOGICAL OBJECTS AND TYPES (CIDOC CRM)
# ----------------------------------------------------------------------------

:spearhead_1 a crm:E22_Human-Made_Object ;
    rdfs:label "Spearhead 1"@en ;
    crm:P1_is_identified_by :spearhead_1_id ;
    # Shortcuts (always present, used by queries) ...
    crm:P2_has_type aat:300037118 ;            # spearheads
    crm:P45_consists_of aat:300241441 ;        # <copper and copper alloy>
    # ... and the full type assignments (who/where the classification comes from)
    crm:P41i_was_classified_by :assign_spearhead_1_type, :assign_spearhead_1_mat ;
    crm:P46_is_composed_of :spearhead_1_blade, :spearhead_1_tange ;
    crmarchaeo:AP21i_is_contained_in :Palace_Hoard ;   # CRMarchaeo 2.1.1: is contained in (range A2)
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

:spearhead_1_id a crm:E42_Identifier ;
    crm:P190_has_symbolic_content "T1 2*, y37" .

:spearhead_1_blade a crm:E22_Human-Made_Object ;
    rdfs:label "Spearhead 1, blade"@en ;
    crm:P2_has_type :spearhead_blade ;
    crm:P45_consists_of aat:300241441 ;
    crm:P41i_was_classified_by :assign_spearhead_1_blade_type, :assign_spearhead_1_blade_mat ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

:spearhead_1_tange a crm:E22_Human-Made_Object ;
    rdfs:label "Spearhead 1, tang"@en ;
    crm:P2_has_type :spearhead_tange ;
    crm:P45_consists_of aat:300241441 ;
    crm:P41i_was_classified_by :assign_spearhead_1_tange_type, :assign_spearhead_1_tange_mat ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

:assign_spearhead_1_type a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1 ;
    crm:P42_assigned aat:300037118 .

:assign_spearhead_1_mat a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1 ;
    crm:P42_assigned aat:300241441 .

:assign_spearhead_1_blade_type a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1_blade ;
    crm:P42_assigned :spearhead_blade .

:assign_spearhead_1_blade_mat a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1_blade ;
    crm:P42_assigned aat:300241441 .

:assign_spearhead_1_tange_type a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1_tange ;
    crm:P42_assigned :spearhead_tange .

:assign_spearhead_1_tange_mat a crm:E17_Type_Assignment ;
    crm:P41_classified :spearhead_1_tange ;
    crm:P42_assigned aat:300241441 .

aat:300241441 a crm:E57_Material ;
    skos:prefLabel "<copper and copper alloy>"@en ;
    skos:inScheme aat: .

aat:300037118 a crm:E55_Type ;
    skos:prefLabel "spearheads"@en ;
    skos:inScheme aat: .

:spearhead_blade a crm:E55_Type ;
    skos:prefLabel "spearhead blade"@en ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

:spearhead_tange a crm:E55_Type ;
    skos:prefLabel "spearhead tang"@en ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

# A local phase of the source database, until it is in PeriodO (LOD-AM/ingest#17):
# in its chronology system and part of its culture. Values as in the database.
:arslantepe_periods a skos:ConceptScheme ;
    skos:prefLabel "Arslantepe periods"@en, "Arslantepe Stufen"@de .

:Arslantepe_VIA a crm:E4_Period ;
    rdfs:label "Arslantepe VIA"@en, "Arslantepe VIA"@de ;
    skos:inScheme :arslantepe_periods ;
    crm:P9i_forms_part_of :northern_mesopotamian_late_chalcolithic ;
    crm:P4_has_time-span :Arslantepe_VIA_time_span .

:Arslantepe_VIA_time_span a crm:E52_Time-Span ;
    crm:P79_beginning_is_qualified_by "-3350" ;
    crm:P80_end_is_qualified_by "-3000" .

:northern_mesopotamian_late_chalcolithic a crm:E4_Period ;
    rdfs:label "Northern Mesopotamian Late Chalcolithic"@en, "Nordmesopotamisches Spätchalkolithikum"@de ;
    crm:P9_consists_of :Arslantepe_VIA .

# ----------------------------------------------------------------------------
# SCIENTIFIC ANALYSIS (Allotrope Foundation Ontologies)
# ----------------------------------------------------------------------------

# ========== LABORATORY (ROR) ==========
:sapienza_lab a crm:E74_Group ;
    rdfs:label "Sapienza University of Rome"@en ;
    dcterms:identifier "02be6w209" ;
    owl:sameAs ror:02be6w209 .

# ========== SAMPLING AND SAMPLE ==========
# The sample is taken from the blade (CRMsci 3.2). The AFO material class is on the sample only.
:sampling_ARSL31A a crmsci:S2_Sample_Taking ;
    crmsci:O3_sampled_from :spearhead_1_blade ;
    crmsci:O5_removed :sample_ARSL31A .

:sample_ARSL31A a crmsci:S13_Sample, afm:AFM_0001099 ;   # afm: chemical mixture
    rdfs:label "Sample from Spearhead 1 Blade (ARSL31A)"@en .

# ========== ANALYSIS ==========
:ARSL31A a afp:AFP_0000527, crm:E7_Activity ;  # afp: spectrometry (closest AFO match)
    dcterms:identifier "ARSL31A" ;
    rdfs:label "optical emission spectrometry with inductively-coupled plasma excitation (ICP Iris-AP)"@en ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> ;
    crm:P14_carried_out_by :sapienza_lab ;
    afx:AFX_0000399 :sample_ARSL31A ;  # afx: has input
    afx:AFX_0000395 :Cu_measurement, :Ag_measurement, :As_measurement, :Ni_measurement, :Sb_measurement, :Pb_measurement, :Fe_measurement, :Zn_measurement, :Co_measurement, :Bi_measurement .

# ========== MEASUREMENTS ==========
:Cu_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:28694 ;  # copper atom
    qudt:numericValue "97"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:Ag_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:30512 ;  # silver atom
    qudt:numericValue "0.002"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:As_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:27563 ;  # arsenic atom
    qudt:numericValue "3.11"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:Ni_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:28112 ;  # nickel atom
    qudt:numericValue "0.002"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:Sb_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:30513 ;  # antimony atom
    qudt:numericValue "0.007"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:Pb_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:25016 ;  # lead atom
    afx:AFX_0000331 [ qudt:numericValue "0.001"^^xsd:decimal ] ;  # afx: maximum -> reported as "<0.001 %"
    qudt:unit unit:PERCENT .

:Fe_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:18248 ;  # iron atom
    qudt:numericValue "0.008"^^xsd:decimal ;
    qudt:unit unit:PERCENT .

:Zn_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:27363 ;  # zinc atom
    afx:AFX_0000331 [ qudt:numericValue "0.001"^^xsd:decimal ] ;  # afx: maximum -> reported as "<0.001 %"
    qudt:unit unit:PERCENT .

:Co_measurement a afr:AFR_0002099 ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:27638 ;  # cobalt atom
    afx:AFX_0000331 [ qudt:numericValue "0.001"^^xsd:decimal ] ;  # afx: maximum -> reported as "<0.001 %"
    qudt:unit unit:PERCENT .

# "Not detected" (knowledge-graph#21): the element was looked for but not found, and no
# detection limit is known. No value; the local type :not_detected instead. Exactly one of
# qudt:numericValue, afx:AFX_0000331 (maximum) or this type. crm:E54_Dimension makes the node
# a CRM entity, so crm:P2_has_type is used within its domain.
# Illustration of the pattern only: this Bi value is not taken from the article.
:Bi_measurement a afr:AFR_0002099, crm:E54_Dimension ;   # mass fraction (wt %)
    afx:AFX_0002816 chebi:33301 ;  # bismuth atom
    crm:P2_has_type :not_detected ;
    qudt:unit unit:PERCENT .

# ========== LEAD ISOTOPE ANALYSIS (knowledge-graph#14) ==========
# Dagger ARSL 18 from Arslantepe, published in the same article. The article reports
# three ratios for it (207/206, 208/206, 204/206); only reported ratios are stated.
# Nuclides are Wikidata items (ChEBI has only lead-207). Ratios have no unit.
:dagger_ARSL18 a crm:E22_Human-Made_Object ;
    rdfs:label "Dagger ARSL 18"@en ;
    crm:P1_is_identified_by :dagger_ARSL18_id ;
    crm:P2_has_type :type_201, aat:300037058 ;  # local typology type + its AAT match (daggers (weapons))
    crm:P45_consists_of aat:300241441 ;        # <copper and copper alloy>
    crm:P53_has_former_or_current_location :Arslantepe_location ;   # found at the site, no feature known (#19)
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> .

# The local typology (LOD-AM/ingest#10): type 201 of the database, its group and class
:type_201 a crm:E55_Type, skos:Concept ;
    skos:inScheme :typology ;
    skos:prefLabel "flat dagger or dagger, unspecified"@en, "Flachdolch oder Dolch, unbestimmt"@de ;
    skos:broader :dagger_blades ;
    skos:broadMatch aat:300037058 .                 # daggers (weapons)

:dagger_blades a crm:E55_Type, skos:Concept ;
    skos:inScheme :typology ;
    skos:prefLabel "dagger blades or daggers with organic handle"@en, "Dolchklingen oder Dolche mit organischem Griff"@de ;
    skos:broader :daggers ;
    skos:broadMatch aat:300037058 .

:daggers a crm:E55_Type, skos:Concept ;
    skos:inScheme :typology ;
    skos:prefLabel "daggers"@en, "Dolche"@de ;
    skos:broader :daggers_and_other_blades ;
    skos:closeMatch aat:300037058 .

:daggers_and_other_blades a crm:E55_Type, skos:Concept ;
    skos:inScheme :typology ;
    skos:prefLabel "daggers and other blades"@en, "Dolche und andere Klingen"@de ;
    skos:topConceptOf :typology .

:dagger_ARSL18_id a crm:E42_Identifier ;
    crm:P190_has_symbolic_content "ARSL 18" .

aat:300037058 a crm:E55_Type ;
    skos:prefLabel "daggers (weapons)"@en ;
    skos:inScheme aat: .

:sampling_ARSL18 a crmsci:S2_Sample_Taking ;
    crmsci:O3_sampled_from :dagger_ARSL18 ;
    crmsci:O5_removed :sample_ARSL18 .

:sample_ARSL18 a crmsci:S13_Sample, afm:AFM_0001099 ;   # afm: chemical mixture
    rdfs:label "Sample from Dagger ARSL 18"@en .

:ARSL18_pb a afp:AFP_0001427, crm:E7_Activity ;   # afp: mass spectrometry
    rdfs:label "Lead isotope analysis of dagger ARSL 18"@en ;
    crm:P70i_is_documented_in <https://doi.org/10.3406/paleo.2002.4745> ;
    afx:AFX_0000399 :sample_ARSL18 ;               # afx: has input
    afx:AFX_0000395 :ARSL18_pb207_206, :ARSL18_pb208_206, :ARSL18_pb204_206 .   # afx: has output

:ARSL18_pb207_206 a afr:AFR_0002368 ;     # analyte molar ratio
    afx:AFX_0002816 wd:Q18883443 ;          # quantifies lead-207 (numerator)
    afx:AFX_0001550 wd:Q18883438 ;          # has reference lead-206 (denominator)
    qudt:numericValue "0.8374"^^xsd:decimal .

:ARSL18_pb208_206 a afr:AFR_0002368 ;     # analyte molar ratio
    afx:AFX_0002816 wd:Q16670466 ;          # quantifies lead-208
    afx:AFX_0001550 wd:Q18883438 ;          # has reference lead-206
    qudt:numericValue "2.0743"^^xsd:decimal .

:ARSL18_pb204_206 a afr:AFR_0002368 ;     # analyte molar ratio
    afx:AFX_0002816 wd:Q18883429 ;          # quantifies lead-204
    afx:AFX_0001550 wd:Q18883438 ;          # has reference lead-206
    qudt:numericValue "0.05347"^^xsd:decimal .

# ----------------------------------------------------------------------------
# LITERATURE (FaBiO + PRISM + Dublin Core)
