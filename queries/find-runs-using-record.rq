# The statistical analysis runs that used a record (LOD-AM/planning#50), with the data
# release they read (version DOI of the website release, #48), the code and the results.
# Pattern: the run prov:used one prov:Collection whose prov:hadMember are the analysed
# records; the collection prov:wasDerivedFrom the release; the code is the prov:hadPlan
# of the run's prov:qualifiedAssociation.
PREFIX :     <https://lod-am.net/id/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?record ?run ?label ?release ?code ?result ?ended WHERE {
  VALUES ?record { :ARSL31A }
  ?input prov:hadMember ?record ;
         prov:wasDerivedFrom ?release .
  ?run   prov:used ?input ;
         rdfs:label ?label ;
         prov:qualifiedAssociation/prov:hadPlan ?code ;
         prov:generated ?result ;
         prov:endedAtTime ?ended .
}
ORDER BY ?run ?result
